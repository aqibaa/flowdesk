# Copy to .env.local and fill in from Supabase -> Project Settings -> API Keys.
# .env* files are git-ignored. Never commit real values.

# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret (server-only). Used exclusively by lib/supabase/admin.js for
# auth.admin operations such as inviting employees. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_...
